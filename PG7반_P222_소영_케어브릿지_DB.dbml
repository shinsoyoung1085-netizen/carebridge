// 케어브릿지 (CareBridge) 데이터 모델
// 장기요양기관 실무자 원격 업무지원 매칭 플랫폼

Table organizations {
  id integer [pk, increment]
  name varchar(100) [not null]
  biz_reg_no varchar(20) [unique, not null, note: '사업자등록번호']
  address varchar(200)
  phone varchar(20)
  org_type varchar(30) [note: '요양원, 재가센터 등']
  created_at timestamp [not null, default: `now()`]
}

Table users {
  id integer [pk, increment]
  org_id integer [ref: > organizations.id, note: '숙련자는 null 가능']
  role varchar(20) [not null, note: 'staff(기관담당자) / expert(숙련자) / admin(관리자)']
  name varchar(50) [not null]
  email varchar(100) [unique, not null]
  password_hash varchar(255) [not null, note: '단방향 해시. 원문 저장 금지 (REQ-NFN-002)']
  phone varchar(20)
  status varchar(20) [not null, default: 'active', note: 'active / suspended']
  created_at timestamp [not null, default: `now()`]
}

Table expert_profiles {
  user_id integer [pk, ref: - users.id]
  bio text
  career_years integer
  rating_avg decimal(3,2) [default: 0]
  review_count integer [default: 0]
}

Table categories {
  id integer [pk, increment]
  name varchar(50) [not null, unique]
  description varchar(200)
}

Table expert_categories {
  id integer [pk, increment]
  expert_id integer [ref: > users.id]
  category_id integer [ref: > categories.id]

  indexes {
    (expert_id, category_id) [unique]
  }
}

Table cases {
  id integer [pk, increment]
  requester_id integer [ref: > users.id, note: '기관담당자 (REQ-FUNC-003)']
  category_id integer [ref: > categories.id]
  title varchar(100) [not null]
  description text [not null]
  status varchar(20) [not null, default: '등록', note: '등록/매칭요청/매칭완료/상담중/해결/종료']
  created_at timestamp [not null, default: `now()`]
  resolved_at timestamp
}

Table attachments {
  id integer [pk, increment]
  case_id integer [ref: > cases.id]
  file_url varchar(255) [not null]
  file_name varchar(100) [not null, note: 'REQ-FUNC-014 케이스 첨부사진']
  uploaded_at timestamp [not null, default: `now()`]
}

Table matches {
  id integer [pk, increment]
  case_id integer [ref: > cases.id]
  expert_id integer [ref: > users.id]
  status varchar(20) [not null, default: '요청', note: '요청/수락/거절/완료 (REQ-FUNC-006)']
  requested_at timestamp [not null, default: `now()`]
  responded_at timestamp
}

Table consult_sessions {
  id integer [pk, increment]
  match_id integer [ref: > matches.id]
  remote_tool varchar(30) [note: '이지헬프(ezHelp) / AnyDesk / Zoom 등 (REQ-FUNC-007)']
  access_code varchar(20) [note: '숙련자가 발급한 원격지원 접속코드']
  status varchar(20) [not null, default: '대기', note: '대기/진행중/완료/취소']
  memo text
  started_at timestamp
  ended_at timestamp
}

Table reviews {
  id integer [pk, increment]
  session_id integer [ref: - consult_sessions.id]
  rater_id integer [ref: > users.id, note: '기관담당자 (REQ-FUNC-008)']
  rating integer [not null, note: '1~5']
  comment varchar(500)
  created_at timestamp [not null, default: `now()`]
}

Table solution_archive {
  id integer [pk, increment]
  category_id integer [ref: > categories.id]
  source_case_id integer [ref: > cases.id, note: '원본 케이스, 수기 등록시 null 가능 (REQ-FUNC-009)']
  title varchar(100) [not null]
  content text [not null]
  is_published boolean [not null, default: false, note: '관리자 승인 여부 (REQ-FUNC-011)']
  view_count integer [not null, default: 0]
  created_by integer [ref: > users.id]
  created_at timestamp [not null, default: `now()`]
}

Table notifications {
  id integer [pk, increment]
  user_id integer [ref: > users.id]
  type varchar(30) [not null, note: 'match_request/match_accepted/session_started 등']
  content varchar(200) [not null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null, default: `now()`]
}
