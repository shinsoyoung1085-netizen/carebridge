# 백엔드 환경변수 예시. 로컬에서는 이 파일을 .env로 복사해 값을 채우고,
# 배포 환경에서는 호스팅 서비스의 환경변수 설정에 같은 이름으로 넣는다.

OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/carebridge
# 운영용은 새로 생성: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# 쉼표로 구분한 프런트엔드 주소 목록
CORS_ORIGINS=http://localhost:5173

# 관리형 DB의 자동 백업을 쓰면 false
BACKUP_ENABLED=true
